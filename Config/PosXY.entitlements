<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared keychain group for the widget status (see iOSShared/RecordingStatus.swift).
	     Every provisioning profile allows TEAMID.*, so this works with a free Apple ID too. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(APP_BUNDLE_ID).shared</string>
	</array>
</dict>
</plist>
